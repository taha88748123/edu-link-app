  <artifactId>shared-observability</artifactId>
  <name>NAJA7I — Shared Observability</name>
  <description>Resources-only jar that exposes a common logback configuration
                (JSON for `docker` profile, human-readable otherwise) usable
                from every service via `&lt;include resource="logback-spring-naja7i.xml"/&gt;`.</description>

  <!-- No Java sources, no runtime dependencies. The logstash encoder is provided
       at runtime by the consuming service (managed via the parent BOM). -->
</project>
