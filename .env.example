# NAJA7I-APP — env vars template
# Copy to `.env` (gitignored). Lines left empty mean "use the logging driver" — the
# service will boot without external creds and skip the external call.

# ─── Secrets (REQUIRED) ──────────────────────────────────────────────────────
# 32+ chars (HS512). Generate: `openssl rand -hex 32`
NAJA7I_JWT_SECRET=change-me-please-this-is-a-dev-secret-32+chars-required

# Shared between booking ↔ calendar ↔ pricing for internal REST calls
NAJA7I_INTERNAL_KEY=dev-internal-key

# ─── E2E test backdoor (set ONLY for Playwright runs — NEVER in prod) ────────
# When true, auth-service exposes GET /api/v1/dev/auth/otp/{userId} (port 8101,
# NOT routed by the gateway) so e2e tests can fetch OTP without SMS.
NAJA7I_AUTH_TEST_MODE=false

# ─── Observability (auto-wired with the observability profile) ───────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces

# ─── Notification drivers (default: logging = no external call) ──────────────
# Each driver can be: logging | twilio (SMS/WA) | smtp | sendgrid | firebase
NOTIF_SMS_DRIVER=logging
NOTIF_WA_DRIVER=logging
NOTIF_EMAIL_DRIVER=smtp           # Mailhog SMTP on 1025; switch to sendgrid for prod
NOTIF_PUSH_DRIVER=logging
NOTIF_EMAIL_FROM=noreply@naja7i.local

# Twilio — required only when NOTIF_SMS_DRIVER or NOTIF_WA_DRIVER = twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                # SMS sender (E.164: +212...)
TWILIO_WA_FROM_NUMBER=             # WhatsApp sender (whatsapp:+212...)

# SendGrid — required only when NOTIF_EMAIL_DRIVER = sendgrid
SENDGRID_API_KEY=

# Firebase Cloud Messaging — required only when NOTIF_PUSH_DRIVER = firebase
FIREBASE_SERVICE_ACCOUNT_PATH=     # absolute path to the service-account JSON

# ─── AI agents (default: logging = deterministic baseline, no API call) ─────
# Switch to `anthropic` to enable Claude. ANTHROPIC_API_KEY then required.
NAJA7I_CHAT_MODERATION_DRIVER=logging
NAJA7I_AI_MATCHING_DRIVER=logging
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ─── LiveKit (video) ─────────────────────────────────────────────────────────
# The video-session-service mints LiveKit-compatible JWTs by default (no server
# required for the JWT itself). Connect from the browser fails gracefully when
# no LiveKit server is reachable.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=dev-api-key
LIVEKIT_API_SECRET=dev-api-secret-32-chars-minimum-padding

# ─── Database overrides (rarely needed in dev) ──────────────────────────────
POSTGRES_USER=naja7i
POSTGRES_PASSWORD=naja7i_dev
