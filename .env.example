# NAJA7I-APP — exemple de variables d'env (copier vers .env, NE PAS COMMIT)
# JWT — minimum 32 caractères pour HS512
NAJA7I_JWT_SECRET=change-me-please-this-is-a-dev-secret-32+chars

# Twilio (OTP SMS + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WA=

# SendGrid
SENDGRID_API_KEY=

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_API_KEY=          # fallback

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres (override si besoin)
POSTGRES_USER=naja7i
POSTGRES_PASSWORD=naja7i_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
